# Database Configuration
POSTGRES_DB=celtic
POSTGRES_USER=celtic
POSTGRES_PASSWORD=your_secure_password_here

# JWT Configuration
JWT_KEY=your_secure_32_character_key_here
JWT_ISSUER=celtic-api
JWT_AUDIENCE=celtic-app

# Frontend/CORS Configuration
# ALLOWED_ORIGINS must match your live domain exactly
ALLOWED_ORIGINS=https://footy.jebbs.online
# NUXT_PUBLIC_API_BASE should use the Docker service name when running in Docker
NUXT_PUBLIC_API_BASE=http://celtic-api

# nginx-proxy auto-discovery (used by jwilder/nginx-proxy)
DOMAIN=footy.jebbs.online
LETSENCRYPT_EMAIL=your_email@example.com
